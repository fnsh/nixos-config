+// send transmits a compressed respondd package. On stream connections (e.g.
+// TCP) the package is framed and a broken connection is dialed again on the
+// next call (e.g. after a restart of the remote yanic instance).
+func (conn *Connection) send(raw []byte) error {
+	conn.connMux.Lock()
+	defer conn.connMux.Unlock()
+
+	if conn.conn == nil {
+		c, err := net.Dial(conn.config.Type(), conn.config.Address())
+		if err != nil {
+			return err
+		}
+		conn.conn = c
+	}
+
+	var err error
+	if conn.config.Streamed() {
+		err = respond.WriteFrame(conn.conn, raw)
+	} else {
+		_, err = conn.conn.Write(raw)
+	}
+
+	if err != nil && conn.config.Streamed() {
+		// drop broken connection, redial on next send
+		if errClose := conn.conn.Close(); errClose != nil {
+			logger.WithError(errClose).Error("could not close broken connection")
+		}
+		conn.conn = nil
+	}
+	return err
+}
+
 func (conn *Connection) InsertLink(link *runtime.Link, time time.Time) {
 }
 
@@ -99,7 +138,13 @@ func (conn *Connection) PruneNodes(deleteAfter time.Duration) {
 }
 
 func (conn *Connection) Close() {
+	conn.connMux.Lock()
+	defer conn.connMux.Unlock()
+	if conn.conn == nil {
+		return
+	}
 	if err := conn.conn.Close(); err != nil {
 		logger.WithError(err).Error("cound not close socket")
 	}
+	conn.conn = nil
 }
