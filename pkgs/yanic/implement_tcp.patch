index 73c0415..f9a183a 100644
--- a/respond/respond_test.go
+++ b/respond/respond_test.go
@@ -1,6 +1,7 @@
 package respond
 
 import (
+	"bytes"
 	"net"
 	"testing"
 
@@ -18,3 +19,40 @@ func TestNewRespone(t *testing.T) {
 	assert.Equal("[fe80::2]:8080", data.Address.String())
 	assert.Equal([]uint8{0xca, 0x2b, 0xcd, 0xc9, 0xe1, 0x2, 0x0, 0x0, 0x0, 0xff, 0xff}, data.Raw)
 }
+
+func TestFrame(t *testing.T) {
+	assert := assert.New(t)
+
+	buf := new(bytes.Buffer)
+
+	// roundtrip of two frames on one stream
+	assert.NoError(WriteFrame(buf, []byte("first")))
+	assert.NoError(WriteFrame(buf, []byte("second")))
+
+	raw, err := ReadFrame(buf)
+	assert.NoError(err)
+	assert.Equal([]byte("first"), raw)
+
+	raw, err = ReadFrame(buf)
+	assert.NoError(err)
+	assert.Equal([]byte("second"), raw)
+
+	// empty stream
+	_, err = ReadFrame(buf)
+	assert.Error(err)
+
+	// truncated frame
+	assert.NoError(WriteFrame(buf, []byte("truncated")))
+	buf.Truncate(buf.Len() - 2)
+	_, err = ReadFrame(buf)
+	assert.Error(err)
+
+	// oversized frame is not written
+	assert.Error(WriteFrame(buf, make([]byte, MaxDataGramSize+1)))
+
+	// invalid frame sizes are not read
+	_, err = ReadFrame(bytes.NewReader([]byte{0, 0, 0, 0}))
+	assert.Error(err)
+	_, err = ReadFrame(bytes.NewReader([]byte{0xff, 0xff, 0xff, 0xff}))
+	assert.Error(err)
+}
