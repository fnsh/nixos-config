diff --git a/respond/respond.go b/respond/respond.go
index de276a0..76196f2 100644
--- a/respond/respond.go
+++ b/respond/respond.go
@@ -3,7 +3,9 @@ package respond
 import (
 	"bytes"
 	"compress/flate"
+	"encoding/binary"
 	"encoding/json"
+	"fmt"
 	"io"
 	"net"
 
@@ -24,6 +26,44 @@ const (
 	MaxDataGramSize = 8192
 )
 
+// frameHeaderSize is the size of the length prefix of a respondd frame
+// on stream connections (e.g. TCP) between yanic instances
+const frameHeaderSize = 4
+
+// WriteFrame writes a raw respondd package as a length-prefixed frame to a
+// stream connection (e.g. TCP). Stream connections have no message boundaries,
+// so each package is prefixed with its size as big endian uint32.
+func WriteFrame(w io.Writer, raw []byte) error {
+	if len(raw) > MaxDataGramSize {
+		return fmt.Errorf("frame of %d bytes exceeds maximum of %d bytes", len(raw), MaxDataGramSize)
+	}
+	header := make([]byte, frameHeaderSize)
+	binary.BigEndian.PutUint32(header, uint32(len(raw)))
+	if _, err := w.Write(header); err != nil {
+		return err
+	}
+	_, err := w.Write(raw)
+	return err
+}
+
+// ReadFrame reads a length-prefixed respondd frame written by WriteFrame
+// from a stream connection (e.g. TCP)
+func ReadFrame(r io.Reader) ([]byte, error) {
+	header := make([]byte, frameHeaderSize)
+	if _, err := io.ReadFull(r, header); err != nil {
+		return nil, err
+	}
+	size := binary.BigEndian.Uint32(header)
+	if size == 0 || size > MaxDataGramSize {
+		return nil, fmt.Errorf("invalid frame size: %d", size)
+	}
+	raw := make([]byte, size)
+	if _, err := io.ReadFull(r, raw); err != nil {
+		return nil, err
+	}
+	return raw, nil
+}
+
 // Response of the respond request
 type Response struct {
 	Address *net.UDPAddr
