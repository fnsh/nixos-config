 	"github.com/FreifunkBremen/yanic/runtime"
 	"github.com/stretchr/testify/assert"
 )
@@ -47,3 +54,68 @@ func TestStart(t *testing.T) {
 	conn.Close()
 
 }
+
+func TestStartTCP(t *testing.T) {
+	assert := assert.New(t)
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NoError(err)
+	defer listener.Close()
+
+	conn, err := Connect(map[string]interface{}{
+		"type":    "tcp",
+		"address": listener.Addr().String(),
+	})
+	assert.NoError(err)
+
+	server, err := listener.Accept()
+	assert.NoError(err)
+
+	node := &runtime.Node{
+		Nodeinfo: &data.Nodeinfo{
+			NodeID:   "73deadbeaf13",
+			Hostname: "inject-test",
+		},
+	}
+	conn.InsertNode(node)
+
+	// receive the framed package and verify its content
+	raw, err := respond.ReadFrame(server)
+	assert.NoError(err)
+
+	deflater := flate.NewReader(bytes.NewReader(raw))
+	jsonData, err := io.ReadAll(deflater)
+	assert.NoError(err)
+
+	res := &data.ResponseData{}
+	assert.NoError(json.Unmarshal(jsonData, res))
+	assert.Equal("73deadbeaf13", res.Nodeinfo.NodeID)
+
+	// break the connection and expect the sender to dial again
+	assert.NoError(server.Close())
+
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		if c, err := listener.Accept(); err == nil {
+			accepted <- c
+		}
+	}()
+
+	var server2 net.Conn
+	for i := 0; i < 100 && server2 == nil; i++ {
+		conn.InsertNode(node)
+		select {
+		case server2 = <-accepted:
+		case <-time.After(time.Millisecond * 50):
+		}
+	}
+	if !assert.NotNil(server2, "sender did not reconnect") {
+		return
+	}
+
+	raw, err = respond.ReadFrame(server2)
+	assert.NoError(err)
+	assert.NotNil(raw)
+
+	conn.Close()
+}
