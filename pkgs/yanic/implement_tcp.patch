+// listenTCP starts a TCP listener to receive framed respondd packages
+// from other yanic instances (see database/respondd with a tcp type)
+func (coll *Collector) listenTCP(address string) {
+	listener, err := net.Listen("tcp", address)
+	if err != nil {
+		log.WithField("address", address).Panic(err)
+	}
+
+	coll.tcpListeners = append(coll.tcpListeners, listener)
+
+	// Start acceptor
+	go coll.acceptTCP(listener)
+}
+
+func (coll *Collector) acceptTCP(listener net.Listener) {
+	for {
+		conn, err := listener.Accept()
+		if err != nil {
+			select {
+			case <-coll.stop:
+			default:
+				log.WithError(err).WithField("local", listener.Addr()).Error("Accept failed")
+			}
+			return
+		}
+
+		coll.tcpConnsMux.Lock()
+		coll.tcpConns[conn] = nil
+		coll.tcpConnsMux.Unlock()
+
+		go coll.receiverTCP(conn)
+	}
+}
+
+func (coll *Collector) receiverTCP(conn net.Conn) {
+	defer func() {
+		coll.tcpConnsMux.Lock()
+		delete(coll.tcpConns, conn)
+		coll.tcpConnsMux.Unlock()
+		if err := conn.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+			log.WithError(err).Error("close of tcp connection")
+		}
+	}()
+
+	src := &net.UDPAddr{Port: PortDefault}
+	if addr, ok := conn.RemoteAddr().(*net.TCPAddr); ok {
+		src.IP = addr.IP
+		src.Zone = addr.Zone
+	}
+
+	for {
+		raw, err := ReadFrame(conn)
+		if err != nil {
+			if err != io.EOF && !errors.Is(err, net.ErrClosed) {
+				log.WithError(err).WithFields(map[string]interface{}{
+					"local":  conn.LocalAddr(),
+					"remote": conn.RemoteAddr(),
+				}).Error("ReadFrame failed")
+			}
+			return
+		}
+
+		select {
+		case coll.queue <- &Response{
+			Address: src,
+			Raw:     raw,
+		}:
+		case <-coll.stop:
+			return
+		}
+	}
+}
+
 // Returns a unicast address of given interface (linklocal or global unicast address)
 func getUnicastAddr(iface *net.Interface) (net.IP, error) {
 	addresses, err := iface.Addrs()
@@ -164,6 +249,18 @@ func (coll *Collector) Close() {
 			log.WithError(err).Error("close during collector sockets")
 		}
 	}
+	for _, listener := range coll.tcpListeners {
+		if err := listener.Close(); err != nil {
+			log.WithError(err).Error("close during collector tcp listeners")
+		}
+	}
+	coll.tcpConnsMux.Lock()
+	for conn := range coll.tcpConns {
+		if err := conn.Close(); err != nil {
+			log.WithError(err).Error("close during collector tcp connections")
+		}
+	}
+	coll.tcpConnsMux.Unlock()
 	close(coll.queue)
 }
 
