 	LWTUNNEL_ENCAP_XFRM,
+	LWTUNNEL_ENCAP_IPXLAT,
 	__LWTUNNEL_ENCAP_MAX,
 };
 
diff --git a/net/core/lwtunnel.c b/net/core/lwtunnel.c
