+# deliver a packet translated to IPv6 to a local IPv6 socket
+test_local_delivery_46()
+{
+	RET=0
+
+	# The echo request leaves nsx through the IPv6 output LWT and reaches
+	# ns4 as V4_LOCAL -> V4_NEAR. The reply to V4_LOCAL enters the IPv4
+	# input LWT on the local route, is translated to V6_EAM_NEAR ->
+	# V6_LOCAL and must then be delivered to the local IPv6 ping socket.
+	ip netns exec "$ipxlat_nsx" ping -6 -I "$V6_LOCAL" -c 1 -W 2 \
+		"$V6_EAM_NEAR" >/dev/null 2>&1
+	check_err $? "translated IPv6 echo reply was not delivered locally"
+	log_test "local delivery after 4 to 6 translation"
+}
+
 # return valid packets unsupported by SIIT to the original route
